# Read by ci/hack/build-image.sh.
IMAGE=secure-sign-pqc-operator
CONTAINERFILE=.sealhouse/Containerfile
BINARIES=/usr/local/bin/manager
WRITABLE_PATHS=/tmp
# Image test: with an unreachable API server the operator must stay up,
# retrying its tuning read and serving /healthz, under a random UID.
SMOKE_KUBECONFIG=1
SMOKE_ENV="OPERATOR_NAMESPACE=smoke"
SMOKE_ARGS=""
